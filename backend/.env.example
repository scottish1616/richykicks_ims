# Database
DATABASE_URL=postgresql://richykicks_app:changeme@localhost:5432/richykicks

# Auth
SECRET_KEY=replace-with-a-long-random-value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email (Resend) - backend only, never expose to frontend
RESEND_API_KEY=

# CORS - the frontend origin, no wildcard in production
FRONTEND_ORIGIN=http://localhost:3000

# Rate limiting (requests per window, configurable rather than hardcoded)
LOGIN_RATE_LIMIT=5/minute
PASSWORD_RESET_RATE_LIMIT=3/minute

# App
ENVIRONMENT=development
